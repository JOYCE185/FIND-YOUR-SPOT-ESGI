# Copier ce fichier en ".env" et ajuster. Ne jamais committer le ".env" réel
# (voir section 7.2 du dossier de contexte : rien de sensible dans le dépôt).

PORT=3001

# Redis tourne en local sur le même VPS, pas besoin d'exposer de port public
REDIS_URL=redis://127.0.0.1:6379

# Domaine exact du site en prod (celui que nginx sert en HTTPS)
ALLOWED_ORIGIN=https://votre-domaine.fr

# Durée de vie d'un signalement avant qu'il redevienne "inconnu"
REPORT_TTL_SECONDS=1800

# Délai minimum entre deux signalements d'un même visiteur sur le même parking
COOLDOWN_SECONDS=60
